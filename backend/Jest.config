module.exports = {
    testEnvironment: 'node',
    testMatch: ['**/test/**/*.test.js'],
    testTimeout: 15000,  // socket tests need a bit more time
    clearMocks: true,    // reset mock state between tests automatically
};

/*
 * ─── Required dev dependencies ────────────────────────────────────────────────
 * Add these to your backend package.json devDependencies and run:
 *
 *   npm install --save-dev jest supertest socket.io-client \
 *     mongodb-memory-server cookie-parser @types/jest
 *
 * Then add to package.json scripts:
 *   "test": "jest",
 *   "test:watch": "jest --watch",
 *   "test:coverage": "jest --coverage"
 *
 * ─── Dependency notes ──────────────────────────────────────────────────────────
 * - jest                  test runner
 * - supertest             HTTP route testing without a live server
 * - socket.io-client      needed to test socket events end-to-end
 * - mongodb-memory-server in-process Mongo for schema/model tests (no Docker)
 * - cookie-parser         used in test app setup for auth route tests
 *
 * ─── Mocking strategy ──────────────────────────────────────────────────────────
 * Each test file mocks at the boundary closest to I/O:
 *   - Game / User / Deck models  → jest.mock('../models/...')
 *   - r2client                   → jest.mock('../services/r2client')
 *   - scryfallService            → jest.mock('../services/scryfallService')
 *   - emailService               → jest.mock('../services/emailService')
 *   - auth middleware            → jest.mock('../middleware/auth', ...)
 *
 * Model tests use mongodb-memory-server instead of mocking, so actual
 * Mongoose schema validation and index constraints are exercised.
 */